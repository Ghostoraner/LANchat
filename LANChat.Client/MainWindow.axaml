<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LANChat.Client.ViewModels"
        x:Class="LANChat.Client.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="LAN Chat"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <Grid ColumnDefinitions="320, *">
        
        
        <Border Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, Auto, *">
                <StackPanel Grid.Row="0" Margin="16">
                    <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontSize="13" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="IP-адрес:" FontSize="14" Foreground="#cccccc" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding IpAddress}" IsEnabled="{Binding !IsConnected}" Height="36" FontSize="14" Margin="0,0,0,10"/>

                    <Grid ColumnDefinitions="*, 10, *" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Порт:" FontSize="14" Foreground="#cccccc" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Port}" IsEnabled="{Binding !IsConnected}" Height="36" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ник:" FontSize="14" Foreground="#cccccc" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Username}" IsEnabled="{Binding !IsConnected}" Height="36" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" 
                            Height="40" FontSize="14" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                </StackPanel>

                <Separator Grid.Row="1" Background="#333333" Height="1" Margin="16,0"/>

                
                <Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="16">
                    <TextBlock Grid.Row="0" Text="В СЕТИ" FontSize="13" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding OnlineUsers}" Background="Transparent" BorderThickness="0"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" Foreground="#eeeeee" VerticalAlignment="Center" FontSize="15"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        
        <Grid Grid.Column="1" RowDefinitions="*, Auto" Background="#1e1e1e">
            <ListBox x:Name="LbChat" Grid.Row="0" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Margin="20"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8" HorizontalAlignment="{Binding Alignment}">
                            <StackPanel Orientation="Horizontal" Margin="4,0,4,4" HorizontalAlignment="{Binding Alignment}">
                                <TextBlock Text="{Binding Sender}" FontSize="13" Foreground="#888888" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TimeFormatted}" FontSize="12" Foreground="#555555"/>
                            </StackPanel>
                            <Border CornerRadius="12" Padding="16,12" Background="{Binding BubbleColor}" MaxWidth="700">
                                <TextBlock Text="{Binding Content}" Foreground="White" TextWrapping="Wrap" FontSize="16"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="20,0,20,20">
                <TextBox Grid.Column="0" Text="{Binding MessageText}" Watermark="Введите сообщение..." Height="48" FontSize="16"
                         VerticalContentAlignment="Center" HorizontalAlignment="Stretch">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Отправить" Command="{Binding SendMessageCommand}" 
                        Margin="12,0,0,0" Height="48" FontSize="15" Padding="24,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>